# =============================================================================
# AI Manufacturing Workflow - Environment Variables
# =============================================================================

# PostgreSQL Database Connection URL (Neon Serverless PostgreSQL)
# Sign up at https://neon.tech/ for a free hosted PostgreSQL database.
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API Key (Required for document OCR processing)
# Get a free API key at https://aistudio.google.com/apikey
# This key is used for Gemini Vision OCR to extract fields from uploaded documents.
GEMINI_API_KEY="your-google-gemini-api-key-here"
